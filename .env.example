# api-sports.io usa UNA sola key por cuenta para todos sus productos:
# fútbol (v3.football) y básquet/NBA (v1.basketball, liga id 12) comparten
# esta misma key — solo cambia el plan contratado en cada producto.
API_FOOTBALL_KEY=tu_api_key_de_api-sports_aqui
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui

# Bot y grupo de Telegram para el reporte diario (enviar_telegram.py)
TELEGRAM_BOT_TOKEN=tu_token_de_bot_de_telegram_aqui
TELEGRAM_CHAT_ID=tu_chat_id_del_grupo_aqui

# Puertos fijos de este proyecto (para no confundir con otros proyectos locales)
BACKEND_PORT=5000
FRONTEND_PORT=4200
